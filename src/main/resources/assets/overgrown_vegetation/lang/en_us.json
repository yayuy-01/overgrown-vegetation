  "gui.overgrown_vegetation.visual_settings.atmosphere_enabled": "Jungle Atmosphere",
  "gui.overgrown_vegetation.visual_settings.atmosphere_enabled.desc": "Turns all of the overgrown jungle's effects (ambient sound, light, fog, particles, underwater light) on or off. Off turns every switch below off too. Affects performance (off is the lightest).",
  "gui.overgrown_vegetation.visual_settings.atmosphere_quality": "Atmosphere Quality",
  "gui.overgrown_vegetation.visual_settings.atmosphere_quality.desc": "Number of light shafts, sunflecks and glowing particles, and how fine the fog is. Affects performance. Fog detail is drawn only at High.",
  "gui.overgrown_vegetation.visual_settings.atmosphere_quality.low": "Low",
  "gui.overgrown_vegetation.visual_settings.atmosphere_quality.medium": "Medium",
  "gui.overgrown_vegetation.visual_settings.atmosphere_quality.high": "High",
  "gui.overgrown_vegetation.visual_settings.curled_fern": "Curled Ferns",
  "gui.overgrown_vegetation.visual_settings.curled_fern.desc": "Shape of the curled fern. Detailed = folded fronds (86 faces), Standard = 6 flat fronds (42 faces), Simple = crossed planes like vanilla grass (4 faces). Affects performance. Same setting as Detailed Fern Fronds in Video Settings. Switching to or from Simple reloads resources.",
  "gui.overgrown_vegetation.visual_settings.curled_fern.full": "Detailed",
  "gui.overgrown_vegetation.visual_settings.curled_fern.reduced": "Standard",
  "gui.overgrown_vegetation.visual_settings.curled_fern.simple": "Simple",
  "gui.overgrown_vegetation.visual_settings.effects_with_shader_pack": "Draw with Shader Packs",
  "gui.overgrown_vegetation.visual_settings.effects_with_shader_pack.desc": "Keeps drawing this mod's effects (light, fog, particles) while an Iris shader pack is in use. Some shader packs may show them broken or run slower.",
  "gui.overgrown_vegetation.visual_settings.ambient_insects": "Insect and Reptile Calls",
  "gui.overgrown_vegetation.visual_settings.ambient_insects.desc": "Calls of jungle insects (crickets and others) and reptiles. Off also stops calls already playing. Barely affects performance.",
  "gui.overgrown_vegetation.visual_settings.ambient_wind": "Wind",
  "gui.overgrown_vegetation.visual_settings.ambient_wind.desc": "Wind moving through the canopy. Off also stops the sound already playing. Barely affects performance.",
  "gui.overgrown_vegetation.visual_settings.ambient_cave": "Underground",
  "gui.overgrown_vegetation.visual_settings.ambient_cave.desc": "Dripping water, creaking roots and the hum of spore pools underground in the overgrown region. Silent while the cave light is off. Barely affects performance.",
  "gui.overgrown_vegetation.visual_settings.ambient_underwater": "Underwater",
  "gui.overgrown_vegetation.visual_settings.ambient_underwater.desc": "A muffled low sound while diving in overgrown rivers, ponds and seas. Turns the vanilla underwater ambience down there. Barely affects performance.",
  "gui.overgrown_vegetation.visual_settings.light_shafts": "Light Shafts",
  "gui.overgrown_vegetation.visual_settings.light_shafts.desc": "Light shafts through the canopy and the glowing motes floating in them. Affects performance.",
  "gui.overgrown_vegetation.visual_settings.canopy_dapple": "Sunflecks",
  "gui.overgrown_vegetation.visual_settings.canopy_dapple.desc": "Spots of sunlight on the forest floor and their faint rays. Slightly affects performance.",
  "gui.overgrown_vegetation.visual_settings.canopy_light": "Canopy Light and Shade",
  "gui.overgrown_vegetation.visual_settings.canopy_light.desc": "Lifts the light on the floor of dense forest and adds green bounce light, and canopy shade and tint. Off returns the floor to vanilla darkness and also hides the sunfleck spots on the ground (they are drawn with the shade map). Slightly affects performance.",
  "gui.overgrown_vegetation.visual_settings.fog": "Spore Fog and Morning Mist",
  "gui.overgrown_vegetation.visual_settings.fog.desc": "Spore fog in the forest and morning mist (terrain fog, fog distance and colour, Distant Horizons fog override, giant tree silhouettes beyond the fog). Affects performance.",
  "gui.overgrown_vegetation.visual_settings.fog_detail": "Fog Detail",
  "gui.overgrown_vegetation.visual_settings.fog_detail.desc": "Patchiness and light inside the fog (ray marching). Drawn only at Atmosphere Quality High. Strongly affects performance (the heaviest effect).",
  "gui.overgrown_vegetation.visual_settings.motes": "Falling Leaves and Motes",
  "gui.overgrown_vegetation.visual_settings.motes.desc": "Falling leaves, drifting glowing spores, dusk motes, after-rain drops and steam. Affects performance.",
  "gui.overgrown_vegetation.visual_settings.critters": "Gnats and Hollow Critters",
  "gui.overgrown_vegetation.visual_settings.critters.desc": "Gnat swarms, and bugs bursting out of tree hollows and eyes inside them. Barely affects performance.",
  "gui.overgrown_vegetation.visual_settings.leaf_sway": "Swaying Leaves and Grass",
  "gui.overgrown_vegetation.visual_settings.leaf_sway.desc": "Leaves and grass sway in the wind (moved inside the terrain shader). Slightly affects performance.",
  "gui.overgrown_vegetation.visual_settings.water_life": "Water Surface Effects",
  "gui.overgrown_vegetation.visual_settings.water_life.desc": "Rings and bubbles on water and the sheen of wet ground. Slightly affects performance.",
  "gui.overgrown_vegetation.visual_settings.underwater": "Underwater Light and Algae",
  "gui.overgrown_vegetation.visual_settings.underwater.desc": "Caustics on the bottom, light shafts under water and glowing algae at night. Slightly affects performance.",
  "gui.overgrown_vegetation.visual_settings.section.cave": "Underground",
  "gui.overgrown_vegetation.visual_settings.cave_light": "Cave light",
  "gui.overgrown_vegetation.visual_settings.cave_light.desc": "Under the overgrown forest, only the glow of plants floats in black fog (point lights, mobs lit too). Prototype."
}
